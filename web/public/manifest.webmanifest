{
  "name": "Docket",
  "short_name": "Docket",
  "description": "Self-hosted document archive",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f7f9",
  "theme_color": "#ffffff",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": ["application/pdf", "image/png", "image/jpeg", "image/tiff", "image/gif", "text/plain", "text/markdown", ".pdf", ".png", ".jpg", ".jpeg", ".tif", ".tiff", ".gif", ".txt", ".md"]
        }
      ]
    }
  },
  "shortcuts": [
    { "name": "Inbox", "url": "/" },
    { "name": "Search documents", "url": "/documents" }
  ]
}
