# Postgres connection string. The database must exist; tables are created on startup.
DATABASE_URL=postgres://docket:change-me@postgres.lan:5432/docket

# Claude API key for automatic tagging and component generation.
ANTHROPIC_API_KEY=

# Optional settings (defaults shown)
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=medium                 # low | medium | high | xhigh | max
# AI_ATTACH_PDF=auto               # never | auto (docs <= 5 pages) | always
# AI_MAX_CONTENT_CHARS=60000
# AI_EXAMPLE_COUNT=3               # similar filed docs shown to the model as examples
# OCR_LANGUAGES=eng                # e.g. eng+fra (install languages with the TESSERACT_LANGS build arg)
# WORKER_CONCURRENCY=2
# PUID=1000                        # user/group the container runs as; it owns ./data and ./consume
# PGID=1000

# Semantic search (optional): an OpenAI-compatible embeddings API, plus the
# pgvector extension in the database (CREATE EXTENSION vector; as superuser).
# EMBEDDING_URL=http://llama-swap:8080/v1
# EMBEDDING_MODEL=qwen3-embedding-4b
