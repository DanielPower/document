{
  "name": "@docket/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/index.ts",
    "start": "node --env-file-if-exists=../.env src/index.ts",
    "migrate": "node --env-file-if-exists=../.env src/migrate.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
